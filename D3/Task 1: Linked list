//Task 1: Linked list 
import java.util.Scanner;

// Node class
class Node {

    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}

// Linked List class
class MyLinkedList {

    Node head;

    // Append at end
    void append(int data) {

        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
        } else {

            Node temp = head;

            while (temp.next != null) {
                temp = temp.next;
            }

            temp.next = newNode;
        }
    }

    // Add at beginning
    void addAtBegin(int data) {

        Node newNode = new Node(data);

        newNode.next = head;

        head = newNode;
    }

    // Add after a specific node
    void addInBetween(int data, int after) {

        Node newNode = new Node(data);

        Node temp = head;

        while (temp != null && temp.data != after) {
            temp = temp.next;
        }

        if (temp == null) {
            System.out.println("Node not found");
        } else {

            newNode.next = temp.next;

            temp.next = newNode;

            System.out.println("Node Added");
        }
    }

    // Traverse list
    void traverse() {

        if (head == null) {
            System.out.println("List is empty");
        } else {

            Node temp = head;

            System.out.print("List : ");

            while (temp != null) {

                System.out.print(temp.data + " -> ");

                temp = temp.next;
            }

            System.out.println("null");
        }
    }
}

// Main class
public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        MyLinkedList list = new MyLinkedList();

        int ch;

        do {

            System.out.println("\n1. Append");
            System.out.println("2. Add At Begin");
            System.out.println("3. Add In Between");
            System.out.println("4. Traverse");
            System.out.println("0. Exit");

            System.out.print("Enter choice : ");
            ch = sc.nextInt();

            if (ch == 1) {

                System.out.print("Enter value : ");
                int x = sc.nextInt();

                list.append(x);

                System.out.println("Node Added");
            }

            else if (ch == 2) {

                System.out.print("Enter value : ");
                int x = sc.nextInt();

                list.addAtBegin(x);

                System.out.println("Node Added At Beginning");
            }

            else if (ch == 3) {

                System.out.print("Enter new value : ");
                int x = sc.nextInt();

                System.out.print("Add after which node : ");
                int y = sc.nextInt();

                list.addInBetween(x, y);
            }

            else if (ch == 4) {

                list.traverse();
            }

            else if (ch == 0) {

                System.out.println("Program Ended");
            }

            else {

                System.out.println("Wrong Choice");
            }

        } while (ch != 0);

        sc.close();
    }
}
